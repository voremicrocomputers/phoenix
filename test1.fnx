fn upper_function() {
    puts("calling from upper function");
}

fn reference_test(ref: &&char) {
    *ref = "changed";
}

fn main() {
    fn inner_function() {
        puts("calling from inner function");
    }

    let strvar: &char = "hello world";
    {
        let strvar: &char = "hi";
        puts(strvar);
        let strvar: &char = "never prints";
    }
    puts(strvar);

    let input_value: &char = get_string();
    puts("the input value was:");
    puts(input_value);

    if input_value == "test string" {
        puts("the input value is what we expected");
    } else {
        puts("the input value is not what we expected");
    }

    if input_value == "not true" {
        puts("this should not be printed");
    } else {
        puts("this should be printed");
    }

    upper_function();
    inner_function();

    let test: &char = "original";
    puts(test);
    reference_test(&test);
    puts(test);
}