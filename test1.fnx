fn swap_string(alpha: &string, beta: &string) {
    let tmp: string = *alpha;
    *alpha = *beta;
    *beta = tmp;
}

fn reference_test(alpha: &string, beta: &string) {
    swap_string(alpha, beta);
}

fn main() {
    fn inner_function() {
        puts("calling from inner function");
    }

    let strvar: string = "hello world";
    {
        let strvar: string = "hi";
        puts(strvar);
        let strvar: string = "never prints";
    }
    puts(strvar);
    
    state_test();
    state_test();
    state_test();

    let input_value: string = get_string();
    puts("the input value was:");
    puts(input_value);

    if input_value == "test string" {
        puts("the input value is what we expected");
    } else {
        puts("the input value is not what we expected");
    }

    if input_value == "not true" {
        puts("this should not be printed");
    } else {
        puts("this should be printed");
    }

    upper_function();
    inner_function();

    let test: string = "original";
    let test2: string = "original2";
    puts(test);
    puts(test2);
    reference_test(&test, &test2);
